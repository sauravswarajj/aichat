# =============================================================================
# ENVIRONMENT VARIABLES — copy this file to ".env" and fill in your real keys.
# ".env" itself is git-ignored — never commit real keys.
# =============================================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:2000,http://localhost:3000

# ---- Provider API keys (all kept server-side only, never sent to frontend) ----
GEMINI_API_KEY=
NVIDIA_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
# DeepSeek: one-time 5M free tokens on sign-up, no ongoing free tier after that.
DEEPSEEK_API_KEY=
# xAI Grok: $25 one-time trial credit on sign-up (usually expires in 30-90 days).
XAI_API_KEY=
GROQ_API_KEY=
# ---- Auth — single-owner login, no signup, no forgot-password ----
# These are the ONLY valid credentials. Change them here + restart the server to change your password.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=choose-a-strong-password

# ---- Database — MongoDB Atlas. Everything persistent lives here: login ----
# sessions AND chat threads. Get this from Atlas -> Connect -> Drivers.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/orchestrator?retryWrites=true&w=majority
MONGODB_URI=

# ---- Workflow safety limits ----
# Hard cap on how many agent steps a single workflow run may execute.
MAX_WORKFLOW_ROUNDS=6
# Per-provider-call timeout in milliseconds before it is treated as failed.
PROVIDER_TIMEOUT_MS=30000
# Number of retry attempts for a provider call before giving up (exponential backoff).
PROVIDER_MAX_RETRIES=2
# How many previous turns of a thread are fed back as context when continuing it.
THREAD_HISTORY_LIMIT=10
